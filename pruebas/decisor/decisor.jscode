if (ctx.es_admin) { return [{ json: { ruta: 'silencio', motivo: 'mensaje del admin' } }]; }
// EL BOT CIERRA EL AGRADECIMIENTO (086, idea de Osmany).
// Hasta hoy, en un chat que llevaba una persona el bot callaba SIEMPRE. Inelvis
