    notas.push('Beneficiario YA REGISTRADO automaticamente en el tablero: tarjeta ' + tarjetaCtx + ' y celular ' + celularCtx + ' (uno de los dos lo dio antes en esta misma conversacion; el sistema los junto). El beneficiario YA se confirmo en un turno anterior: NO repitas tarjeta ni celular; confirma solo lo nuevo (el deposito y/o el reparto).');
  } else {
    notas.push('Beneficiario YA REGISTRADO automaticamente en el tablero: tarjeta ' + tarjetaCtx + ' y celular ' + celularCtx + (veniaDeAntes ? ' (uno de los dos lo dio antes en esta misma conversacion; el sistema los junto)' : '') + '. NO llames gestionar_beneficiario (ya esta hecho, igual que el deposito). OBLIGATORIO: tu respuesta a ESTE lote DEBE incluir la confirmacion de estos datos con palabras, tarjeta y celular COMPLETOS, uno por linea (Tarjeta: ... / Celular: ...), sin negrita — aunque el lote traiga ademas un audio o texto hablando de otra cosa, la confirmacion va en el mismo mensaje. Responder solo al resto (un "aqui estoy pendiente" pelado) es un ERROR GRAVE. PROHIBIDO pedirle los datos del beneficiario: ya los dio.' + ' Muestra EXACTAMENTE estas lineas:' + String.fromCharCode(10) + 'Tarjeta: ' + tarjetaCtx + String.fromCharCode(10) + 'Celular: ' + celularCtx);
  }
} else if (visaEnCurso) {
  notas.push('OPERACION EN CURSO: EXTENSION DE VISA, no remesa. NO hace falta ningun dato de destino: PROHIBIDO pedir tarjeta, celular, cuenta o datos de quien recibe. El cliente llena el formulario de la extension (https://acortar.link/extension_de_visa) y paga 5,000 GYD por persona por MMG, todo por adelantado; la captura del deposito la manda por aqui. Si confirma que quiere hacerla, llama abrir_extension_visa con cuantas personas. Despues de pagar, el equipo sube la aplicacion y le avisa.');
} else if (comboEnCurso) {
  notas.push('OPERACION EN CURSO: COMBO DE COMIDA, no remesa. Por CADA combo hacen falta, del destinatario: nombre completo, telefono, direccion lo mas completa posible CON LA PROVINCIA (si la provincia llega aparte, guardala junto a la direccion), una referencia de como llegar o como es el lugar, y el monto de ESE combo en GYD (minimo 25,000 por combo; con varios combos, pregunta cuanto es para cada uno). Cada dato que de el cliente, escrito o por AUDIO, guardalo con registrar_destinatario_combo (una llamada por destinatario, con el numero de ese combo: 1, 2, 3... en el orden en que el cliente los dijo) y pide lo que te diga que falta. Pide en UN SOLO mensaje con TODO lo que falta de TODOS los combos (una linea corta por destinatario), nunca dato por dato. Si el cliente dice que un dato vale para varios combos (misma direccion, "sirve para ambos"), guardalo en CADA uno de esos combos: una llamada por numero de combo. PROHIBIDO pedir un telefono de contacto extra: solo el del destinatario. PROHIBIDO volver a pedir un dato que el cliente ya dio: si la herramienta no lo lista como falta, ya esta. PROHIBIDO pedir tarjeta. PROHIBIDO elegir o prometer productos: los elige una persona del equipo en una llamada DESPUES del pago.' + (comboCompleto ? ' Los datos del combo YA ESTAN COMPLETOS: no pidas mas datos de destino; si no ha pagado, pide el pago por MMG, todo por adelantado.' : ''));
} else if (recargaEnCurso) {
  notas.push('OPERACION EN CURSO: RECARGA DE SALDO, no remesa. El unico dato de destino que hace falta es el NUMERO de telefono cubano a recargar. PROHIBIDO pedir tarjeta. PROHIBIDO pedir los datos de quien recibe. ' + (celularCtx ? ('El numero a recargar YA LO DIO: *' + celularCtx + '*. NO pidas mas datos de destino.') : 'Falta el NUMERO a recargar: pideselo.'));
} else {
  // ESPERA A UN TERCERO, TAMBIEN CON DATOS A MEDIAS (17-ago-2026).
  // `esperaTercero` se calcula arriba pero solo se consultaba en DOS de los tres
  // caminos: con comprobante (dentro de `if (s.comprobante && !sabeDestino)`) y
  // sin ningun dato (dentro de `viaSinDefinir`, que exige que no exista NINGUNO).
  // Faltaba el de en medio -sin comprobante pero con la tarjeta o el celular ya
  // dados-, que es justo el caso del 11-ago con 5926299943: habia dado la tarjeta
  // y recibio la peticion del celular CUATRO veces en cinco minutos mientras
  // decia TRES veces que se lo estaban mandando.
  // Se reutiliza LA MISMA nota que los otros dos caminos a proposito: un solo
  // concepto de espera, no dos. Y sustituye a la peticion en vez de sumarse a
  // ella: dos notas opuestas en el mismo contexto es como se perdieron 27
  // minutos el 10-ago.
  // Con `esperaTercero` en false no cambia absolutamente nada.
  if (esperaTercero && (tarjetaCtx || celularCtx)) {
    notas.push('EL CLIENTE DICE QUE ESTA ESPERANDO LOS DATOS DE QUIEN RECIBE: se los tiene que mandar otra persona. PROHIBIDO volver a pedirselos en este turno. PROHIBIDO preguntarle cuando se los mandan. Acusale recibo en UNA linea corta y dile que quedas pendiente. Nada mas.');
  } else {
  if (tarjetaCtx) { notas.push('Tarjeta cubana detectada: ' + tarjetaCtx + '. Falta el celular ESCRITO. OJO: si el cliente lo dicto en nota de voz, NO se lo pidas de nuevo — muestraselo por escrito y pide confirmacion (regla de numeros dictados). Solo si no lo ha dado de ninguna forma, pideselo.'); }
  if (celularCtx && !rielEfectivo) { notas.push('Celular cubano detectado: ' + celularCtx + '. Falta la tarjeta ESCRITA. OJO: si el cliente la dicto en nota de voz, NO se la pidas de nuevo — muestrasela por escrito y pide confirmacion. Solo si no la ha dado de ninguna forma, pidesela.'); }
  }

// ZELLE: el beneficiario no recibe CUP en una tarjeta, recibe DOLARES.
if (zelleVarios) {
  notas.push('VARIAS CUENTAS ZELLE DETECTADAS: ' + zelleCuentas.join(', ') + '. NO registres ninguna todavía ni mezcles un nombre con un número. Confirma con el cliente, UNA por UNA, qué nombre va con cada cuenta y cuánto va a cada una; después registra cada cuenta por separado con registrar_beneficiario_zelle (posicion/agregar/monto). PROHIBIDO asumir que el primer nombre va con el primer número.');
}
if (s.datos_zelle && !zelleVarios) {
  const cuenta = [s.zelle_nombre ? 'nombre ' + s.zelle_nombre : null,
                  s.zelle_celular ? 'celular de EEUU ' + s.zelle_celular : null,
                  s.zelle_correo ? 'correo ' + s.zelle_correo : null].filter(Boolean).join(' y ');
  // Zelle plus CUP in the same send: the Zelle note must not forbid the CUP part.
  const zelleMixto = /(resto|restante|rest|tarjeta|cup|moneda nacional|supervielle)/i.test(texto);
  // LO ACUMULADO, NO SOLO ESTE LOTE (17-ago-2026). Esta guarda preguntaba por
  // `s.tarjeta || s.celular` -el lote- mientras todo el bloque que la rodea usa
  // `tarjetaCtx / celularCtx` -lo acumulado entre lotes-. Con la tarjeta dada en
  // un lote ANTERIOR y el Zelle ahora, la mezcla no se detectaba y el contexto
  // salia con dos ordenes opuestas: 'Falta el celular ESCRITO ... pideselo' y
  // 'PROHIBIDO pedirle tarjeta ni celular cubano', mas la tool de registro.
