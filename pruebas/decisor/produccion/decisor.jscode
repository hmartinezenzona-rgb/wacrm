const rielEfectivo = String(ctx.riel_operacion || '') === 'efectivo_usd';
let tarjetaCtx = s.tarjeta, celularCtx = s.celular, veniaDeAntes = false;
let zelleNomCtx = s.zelle_nombre, zelleCtaCtx = (s.zelle_nombre_cuenta || s.zelle_correo || s.zelle_celular);
try {
