// With more than one account nothing is registered until each pair is confirmed with the customer.
const zelleCuentas = Array.from(new Set([...(s.zelle_correos || []), ...(s.zelle_celulares || [])]));
const zelleVarios = !!s.zelle_varios || zelleCuentas.length > 1;
if (zelleVarios) { zelleNomCtx = null; zelleCtaCtx = null; }
// Resolver state (optional): the planned split of one deposit between services, when the context node supplies it.
const R = (ctx.servicio_resuelto && typeof ctx.servicio_resuelto === 'object') ? ctx.servicio_resuelto : null;
// RECARGA EN CURSO (13-ago-2026): hoy la recarga de la promo de Etecsa entro
// como "Remesa" y el bot pidio LA TARJETA (Yilian, +5926595697). La senal
