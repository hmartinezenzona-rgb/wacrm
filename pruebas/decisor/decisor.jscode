const NOMBRE_NEGOCIO = JSON.parse($('Datos del negocio').params.jsonOutput).negocio.nombre; // fuente unica (T5): el nombre del negocio vive en 'Datos del negocio'
const ctx = $('Contexto conversacion').first().json;
// HORARIO (136): apertura y cierre salen de cerebro_config via `Contexto conversacion`.
