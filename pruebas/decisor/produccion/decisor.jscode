if (ctx.humano_reciente) { return [{ json: { ruta: 'silencio', motivo: 'un humano del equipo acaba de escribir' } }]; }
// UN ADMIN SIN ACCION RECONOCIDA NO ES UN CLIENTE (18-ago-2026, doc 44).
// Va ANTES de la rama de cortesia a proposito: hasta hoy, un admin que escribia
// 'hola' en un chat asignado con cortesia pendiente entraba en la rama del
