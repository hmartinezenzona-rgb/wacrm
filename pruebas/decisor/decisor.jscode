// A planned split (reparto_planeado) already has its own note.
if (R && !planR && Array.isArray(R.operaciones)) {
  const partesA = R.operaciones.filter((o) => o && Number(o.monto_acordado_gyd) > 0).map((o) => ({ servicio: String(o.servicio || 'parte'), monto: Number(o.monto_acordado_gyd), grupo: !!o.grupo }));
  if (partesA.length >= 2) {
    const f293 = (n) => Number(n).toLocaleString('en-US');
    const pf = (p) => p.servicio + ' ' + f293(p.monto);
    const totalA = partesA.reduce((a, p) => a + p.monto, 0);
    const depA = R.operaciones.reduce((a, o) => a + (o && o.tiene_deposito ? Number(o.dinero_gyd || 0) : 0), 0);
