  // pasara lo que pasara con la verificacion. Por eso ese mismo dia el bot le
  // dijo a un cliente "Recibimos su deposito de 6,762,167 GYD" cuando la propia
  // lectura venia marcada "importe no esta claro" y el envio ya estaba en
  // Incidencia. El SQL acertaba; la frase que leia el modelo, no.
  // Regla del proyecto: si algo tiene que pasar si o si, pasa en el SQL o en el
  // dato, nunca en una frase que el modelo puede ignorar.
  //
  // OJO AL REDACTAR: esto va como MAPEO PLANO estado -> instruccion. Nada de
  // pedirle al modelo que valore, compare o decida, que eso enciende el modo
  // pensamiento de DeepSeek y rompe la conversacion en el turno siguiente
  // (paso el 1, el 5 y el 9 de agosto). Ver 11-lenguaje-deliberativo-*.md
  let cruce = null;
  try { cruce = $('Cruzar deposito con MMG').first().json ?? null; } catch (e) {}
  const veredicto = String(cruce?.resultado ?? 'desconocido');
  // EL SALDO DEL ENVIO (072/074). `saldo` es null cuando el cliente no dijo
  // cuanto iba a enviar, y entonces todo se comporta como antes de existir esto.
  // Las tres cifras vienen YA CALCULADAS del SQL: al agente solo se le pide que
  // las diga. Ver 11-lenguaje-deliberativo-rompe-deepseek.md.
  const saldo      = (cruce && cruce.saldo      !== null && cruce.saldo      !== undefined) ? Number(cruce.saldo)      : null;
  const objetivoEnvio = (cruce && cruce.objetivo   !== null && cruce.objetivo   !== undefined) ? Number(cruce.objetivo)   : null;
  const depositado    = (cruce && cruce.depositado !== null && cruce.depositado !== undefined) ? Number(cruce.depositado) : null;
  // 'verificado', 'verificado_incompleto' y 'verificado_de_mas' son la misma
  // familia: el dinero SI casa con el libro. Lo que cambia es si cubre o no.
  const cruceOK = veredicto === 'verificado' || veredicto === 'verificado_incompleto' || veredicto === 'verificado_de_mas';
  const fmtG = (n) => Number(n ?? 0).toLocaleString('en-US');

  // Si la lectura vino dudosa, no se menciona NINGUNA cifra.
  const estadoV = String(s.comprobante.estado ?? '').toUpperCase();
  const alertasV = (s.comprobante.alertas ?? []).join(' ').toLowerCase();
  // VARIOS COMPROBANTES EN LA MISMA RAFAGA.
  // El 11-ago Melih (5926131647) mando 27.000 + 300 juntos y el bot le confirmo
  // *300 GYD*: `Snapshot final` se quedaba con el ULTIMO y el otro se perdia.
  // Esa noche se puso el parche de callar; esto es el arreglo de verdad. Ahora
  // la rafaga llega ENTERA y YA SUMADA, y `cerebro_cruzar_depositos` ha cruzado
  // los N contra el libro TODO O NADA. Tres ramas, mapeo plano:
  //   uno                          -> exactamente lo de siempre, sin tocar
  //   varios, los N verificados    -> se le confirma EL TOTAL
  //   varios, alguno falla         -> no se dice ninguna cifra (la rama de callar)
  // LA SUMA YA VIENE HECHA. Al agente no se le pide que sume ni que compruebe si
  // cuadra: eso es lenguaje deliberativo, enciende el modo pensamiento de
  // DeepSeek y rompe la conversacion en el turno siguiente. Ver
  // 11-lenguaje-deliberativo-rompe-deepseek.md.
  const nComp = Number(s.comprobantes_n ?? (s.comprobante ? 1 : 0));
  const varios = nComp > 1;
  const sumables = !!s.comprobantes_sumables;
  const totalRafaga = Number(s.comprobantes_total ?? 0);
  const monedaRafaga = String(s.comprobante.moneda ?? 'GYD');
  const importeDudoso = estadoV === 'DESCONOCIDO' || alertasV.includes('no esta claro');
  // `datos` NO cambia: es el comprobante unico, igual que siempre. Meter aqui
  // la rafaga entera alteraba el texto de ramas que no tienen nada que ver
  // (ILEGIBLE, ya_reclamado...) y el banco lo saco en rojo. La rafaga solo la
  // necesita la rama del TOTAL, y se pone alli.
  const datos = JSON.stringify(s.comprobante);
  // S4 (Marlene 4afda26a): a multi-part send (grouped operations) whose verified deposit is SHORT of the agreed total: reconcile the
  // parts. If changing exactly one part by the difference gives a whole-USD amount (the part carries its USD), that is the proposal.
  const reconPartes = (['verificado_incompleto', 'verificado_de_mas'].includes(veredicto))
    ? (planR ? reconciliarPartes(planR.partes, depositado, true)
             : reconciliarPartes(ctx.envio_mixto && Array.isArray(ctx.envio_mixto.partes) ? ctx.envio_mixto.partes : [], depositado, veredicto === 'verificado_incompleto'))
    : null;

  if (varios && !(sumables && cruceOK)) {
    notas.push('EL CLIENTE MANDO VARIOS COMPROBANTES EN LA MISMA RAFAGA y el sistema NO ha podido sumarlos y verificarlos automaticamente. No se ha dado por bueno ni uno solo. PROHIBIDO decir ninguna cifra. PROHIBIDO decir que el deposito fue recibido, verificado o confirmado. PROHIBIDO pedirle que los reenvie. Dile solo esto: que recibiste sus comprobantes, que una persona esta sumando el total y que le confirman en cuanto quede. El envio ya esta en Incidencia.');
  } else if (importeDudoso) {
    notas.push('COMPROBANTE ILEGIBLE. El importe NO se pudo leer con seguridad y el envio ya esta en Incidencia para que lo mire una persona. PROHIBIDO decir ninguna cifra. PROHIBIDO decir que el deposito fue recibido, verificado o confirmado. Dile solo esto: que recibiste su imagen, que no se lee bien, y que una persona la esta revisando. Si lo que mando no era un comprobante, pidele la captura del comprobante. Datos leidos, NO se los repitas al cliente: ' + datos);
  } else if (reconPartes) {
    notas.push(notaReconPartes(reconPartes, depositado, monedaRafaga, 'el banco verifico'));
  } else if (veredicto === 'verificado_incompleto') {
    notas.push('RECIBIDO Y VERIFICADO CONTRA EL BANCO, PERO EL ENVIO TODAVIA NO ESTA COMPLETO. El cliente dijo que iba a enviar *'
      + fmtG(objetivoEnvio) + ' ' + monedaRafaga + '* y hasta ahora lleva *' + fmtG(depositado) + ' ' + monedaRafaga
      + '*: FALTAN *' + fmtG(saldo) + ' ' + monedaRafaga + '*. Confirmale que recibiste lo que mando, DILE CUANTO LLEVA Y CUANTO FALTA con esas tres cifras exactas, y dile que quedas esperando el resto para completar el envio. PROHIBIDO sumar ni restar tu nada: las cifras ya vienen calculadas. PROHIBIDO decir que ya se le va a transferir. PROHIBIDO decir que el envio esta completo. PROHIBIDO pedirle que reenvie lo que ya mando.');
  } else if (veredicto === 'verificado_de_mas') {
    // ENVIO MIXTO (255): the extra money is often a SECOND service the customer already asked for (Clasica + recarga on one
    // deposit, f8b7779c). Same detectors as above (recarga|etecsa|cubacel, combo, visa|inmigraci) over this turn's text and the
    // customer's recent texts, plus the database flags; the operation's own service never counts as the "other" one.
    const previosDeMas = String(ctx.muestra_idioma || '') + ' ' + texto;
    const propioDeMas = String(rielOp || '');
    const otrosDeMas = [];
    const nombreDeMas = { recarga: 'recarga', combo: 'combo de comida', visa: 'visa', saldo: 'saldo movil' };
    if (R) {
      // S4: the other services come from the resolved state (open operations and the declared intent), never from word lists.
      const otros = (Array.isArray(R.operaciones) ? R.operaciones.map((o) => String(o.servicio || '')) : []).concat(declaradoR ? [declaradoR] : []);
      otros.forEach((sv) => { if (sv && sv !== propioDeMas && nombreDeMas[sv] && !otrosDeMas.includes(nombreDeMas[sv])) { otrosDeMas.push(nombreDeMas[sv]); } });
    } else {
    if (propioDeMas !== 'recarga' && (ctx.recarga_en_curso || /recarga|etecsa|cubacel/i.test(previosDeMas))) { otrosDeMas.push('recarga'); }
    if (propioDeMas !== 'combo' && (ctx.combo_en_curso || /combo/i.test(previosDeMas))) { otrosDeMas.push('combo de comida'); }
    if (propioDeMas !== 'visa' && (ctx.visa_en_curso || /visa|inmigraci/i.test(previosDeMas))) { otrosDeMas.push('visa'); }
    if (propioDeMas !== 'saldo' && /saldo\s+m.vil/i.test(previosDeMas)) { otrosDeMas.push('saldo movil'); }
    }
    // S6: the conversation already has a mixed send (ctx.envio_mixto, from `Contexto conversacion`): never "mando de mas".
    const mixtoDeMas = !!(ctx.envio_mixto && Array.isArray(ctx.envio_mixto.partes) && ctx.envio_mixto.partes.length > 1);
    if (mixtoDeMas) {
      notas.push('EL CLIENTE DEPOSITO MAS DE LO QUE DIJO QUE IBA A ENVIAR: dijo *'
        + fmtG(objetivoEnvio) + ' ' + monedaRafaga + '* y lleva *' + fmtG(depositado) + ' ' + monedaRafaga
        + '*, o sea ' + fmtG(Math.abs(saldo)) + ' de mas. Esta conversacion ya es un ENVIO MIXTO (un solo deposito repartido entre varios servicios, ver la nota ENVIO MIXTO). NO le digas que mando de mas ni que es un error. Confirma con el cliente como queda repartido ese deposito entre los servicios (cuantos GYD para cada uno) y, cuando te lo diga, llama repartir_envio con TODAS las partes; las partes tienen que sumar exactamente lo depositado. Responde con lo que devuelva la tool, sin inventar cifras. PROHIBIDO decirle que se le va a transferir antes de que la tool confirme el reparto.');
    } else if (otrosDeMas.length > 0) {
      notas.push('EL CLIENTE DEPOSITO MAS DE LO QUE DIJO QUE IBA A ENVIAR: dijo *'
        + fmtG(objetivoEnvio) + ' ' + monedaRafaga + '* y lleva *' + fmtG(depositado) + ' ' + monedaRafaga
        + '*, o sea ' + fmtG(Math.abs(saldo)) + ' de mas. Ese dinero de mas PROBABLEMENTE es para otro servicio que ya pidio (' + otrosDeMas.join(', ')
        + '). NO le digas que mando de mas ni que es un error. Confirma con el cliente como se reparte ESE deposito entre los servicios (cuantos GYD para cada uno) y, cuando te lo diga, llama repartir_envio con TODAS las partes, por ejemplo "clasica 18200, recarga 6200"; las partes tienen que sumar exactamente lo depositado. Responde con lo que devuelva la tool, sin inventar cifras. PROHIBIDO decirle que se le va a transferir antes de que la tool confirme el reparto.');
    } else {
      notas.push('EL CLIENTE DEPOSITO MAS DE LO QUE DIJO QUE IBA A ENVIAR: dijo *'
      + fmtG(objetivoEnvio) + ' ' + monedaRafaga + '* y lleva *' + fmtG(depositado) + ' ' + monedaRafaga
      + '*, o sea ' + fmtG(Math.abs(saldo)) + ' de mas. El envio esta en Incidencia y lo revisa una persona. PROHIBIDO decirle que se le va a transferir. PROHIBIDO decidir tu que se hace con el dinero de mas. Dile solo que recibiste su deposito, que ves que mando mas de lo que habiais hablado, y que una persona le confirma en breve como lo resuelve.');
    }
  } else if (veredicto === 'verificado' && varios) {
    notas.push('EL CLIENTE MANDO ' + nComp + ' COMPROBANTES EN LA MISMA RAFAGA. El sistema los ha SUMADO y ha verificado los ' + nComp + ' contra el libro del banco, uno por uno, y se han dado por buenos los ' + nComp + '. EL TOTAL ES *' + totalRafaga.toLocaleString('en-US') + ' ' + monedaRafaga + '* y esa es la UNICA cifra que le puedes decir. PROHIBIDO decirle los importes por separado. PROHIBIDO sumar tu ninguna cantidad y PROHIBIDO comprobar si cuadra: la suma ya viene hecha y ya esta verificada. NO hay ninguna tool que llamar PARA LOS COMPROBANTES: solo confirmale ese TOTAL al cliente con palabras. Datos de los ' + nComp + ' comprobantes, NO se los repitas al cliente: ' + JSON.stringify(s.comprobantes));
  } else if (veredicto === 'verificado') {
    notas.push('Comprobante leido y YA REGISTRADO automaticamente en el tablero. NO hay ninguna tool que llamar PARA EL COMPROBANTE: solo confirmalo al cliente con palabras. Datos: ' + datos);
  } else if (veredicto === 'ya_reclamado') {
    notas.push('ESE DEPOSITO YA SE USO EN OTRO ENVIO. El envio esta en Incidencia y lo revisa una persona. PROHIBIDO confirmarle el deposito. PROHIBIDO decirle que se le va a transferir. Dile solo que recibiste su comprobante y que una persona lo esta revisando y le confirma en breve. NO le digas que esta repetido ni le eches la culpa. Datos: ' + datos);
  } else if (veredicto === 'deposito_antiguo') {
    notas.push('EL DEPOSITO ES DEMASIADO ANTIGUO y el envio esta en Incidencia para que lo mire una persona. PROHIBIDO confirmarle el deposito. PROHIBIDO decirle que se le va a transferir. Dile solo que recibiste su comprobante y que una persona lo esta revisando. Datos: ' + datos);
  } else {
    notas.push('Comprobante leido y REGISTRADO en el tablero, pero TODAVIA NO esta verificado. Acusale recibo de su comprobante y dile que lo estan verificando y que le confirman en cuanto quede. PROHIBIDO decir que ya esta verificado o confirmado. PROHIBIDO decirle que el dinero ya se le va a transferir. Datos: ' + datos);
  }
  if (veredicto === 'verificado') { esteTurnoVerificado = true; }

  // Comparacion deterministica: monto del comprobante vs ultima cotizacion del
  // agente. Solo cuando el deposito quedo VERIFICADO: en los demas casos la
  // frase "se le transfiere el equivalente" seria una confirmacion encubierta.
  // `saldo === null` a proposito: cuando el cliente SI dijo cuanto iba a enviar,
  // la cifra buena es el objetivo, no lo que se rasque del texto de la ultima
  // cotizacion — que se midio y falla en la mitad de los mensajes.
  if (veredicto === 'verificado' && (!varios || sumables) && saldo === null) {
    try {
      const moneda = (s.comprobante.moneda || 'GYD');
      const cm = ($('Ultima cotizacion').first().json.ultima_cotizacion || '');
      const re = new RegExp('\\*([0-9][0-9,\\.]*) ' + moneda + '\\*');
      const m2 = cm.match(re);
      const cotizado = m2 ? Number(m2[1].replace(/,/g, '')) : null;
      // Con varios, lo que se compara con la cotizacion es EL TOTAL de la
      // rafaga. Comparar solo el primero diria "distinto a lo cotizado" en
      // una rafaga que cuadra perfectamente al sumarla.
      const depositado = varios ? totalRafaga : Number(s.comprobante.monto);
      if (cotizado && depositado && cotizado !== depositado) {
        notas.push('MONTO DISTINTO AL COTIZADO (OBLIGATORIO senalarlo): antes se hablo de *' + cotizado.toLocaleString('en-US') + ' ' + moneda + '* y el comprobante llego por *' + depositado.toLocaleString('en-US') + ' ' + moneda + '*. En tu confirmacion di con naturalidad que fue distinto a lo hablado y que no hay problema, se le transfiere el equivalente de lo depositado. En la MISMA frase de confirmacion, sin drama, sin pedir explicaciones.');
      }
    } catch (e) {}
  }
}
// B1.2 (2026-09-29): el deposito de la operacion en curso ya estaba
// verificado DESDE ANTES de este turno (verificado a mano desde el panel,
// o un turno anterior sin comprobante nuevo). `Contexto conversacion` lo
// expone en ctx.deposito_ya_verificado. Si la rama de arriba (ESTE mismo
// turno) ya disparo su propia nota, esta NO debe pisarla: de ahi el
// !esteTurnoVerificado. Tampoco dispara sobre un comprobante duplicado:
// esa rama (mas abajo, dupEtapa) ya tiene su propia redaccion para el caso
// 'Lista para transferir' y no se toca aqui.
// Solo en el turno en que llegan los datos de quien recibe (algo de este lote
// + tarjeta y celular completos): es el cierre de ESA confirmacion. Sin esta
// guarda la frase salia en cualquier mensaje de una conversacion con la
// remesa ya verificada.
if (ctx.deposito_ya_verificado && (s.tarjeta || s.celular) && tarjetaCtx && celularCtx
    && !s.multi_beneficiario && !esteTurnoVerificado && !s.comprobante_duplicado) {
  notas.push('EL DEPOSITO DE ESTE ENVIO YA ESTABA VERIFICADO DESDE ANTES DE ESTE TURNO. PROHIBIDO decir "apenas lo verifiquemos", "apenas se confirme su deposito" ni ninguna promesa de verificarlo a futuro: eso YA paso. Al confirmar estos datos, cierra con EXACTAMENTE esta frase, sin cambiarla: "Una vez realizada su remesa le notificaremos por acá."');
}
// EL CLIENTE MANDO UNA IMAGEN QUE NO ES UN COMPROBANTE.
// El 10-ago mando una captura de un chat de WhatsApp. La vision la clasifico
// bien (tipo 'otro'), no se creo ningun deal y no hubo ninguna cifra en ningun
// punto del sistema. Y el agente contesto "Recibimos su deposito de 8,000 GYD",
// invendandoselo entero. Sin una instruccion explicita el modelo rellena el
// hueco con lo mas frecuente del negocio, que es confirmar un deposito.
// Va como mapeo plano, sin pedirle que valore nada.
if (!s.comprobante && (s.alertas || []).some(a => String(a).startsWith('Imagen no reconocida'))) {
  const desc = (s.alertas || [])
    .filter(a => String(a).startsWith('Imagen no reconocida'))
    .map(a => String(a).replace('Imagen no reconocida: ', '').trim())
    .filter(Boolean).join('; ');
  notas.push('LA IMAGEN QUE MANDO NO ES UN COMPROBANTE DE DEPOSITO. Lo que se ve en ella es: ' + (desc || 'no identificable') + '. No se ha registrado nada y NO HAY NINGUN IMPORTE. PROHIBIDO decir que recibiste un deposito. PROHIBIDO decir ninguna cifra. PROHIBIDO decir que lo estas verificando o que se lo confirmas en breve. PROHIBIDO pedirle el comprobante: el cliente NO ha dicho que haya depositado. Sigue la conversacion por donde iba y responde a lo que te dice en el texto de este mismo mensaje.');
}
// YA HAY DEPOSITO: NO SE PREGUNTA POR DONDE VA A DEPOSITAR.
if (ctx.via_deposito_ya_usada) {
  notas.push('EL DEPOSITO YA ESTA HECHO Y REGISTRADO, y entro por *' + String(ctx.via_deposito_ya_usada).trim() + '*. PROHIBIDO preguntarle desde donde va a depositar. PROHIBIDO preguntarle si es por la app o con un agente. PROHIBIDO darle datos de cuenta para depositar. Eso ya paso. Si te pregunta por la cuenta, dile la que ya uso.');
}
// NO SABEMOS A QUIEN TRANSFERIRLE.
// El 10-ago un cliente mando su comprobante, el deposito se verifico y el bot le
// dijo "en breve le hacemos la transferencia" SIN tener tarjeta, celular ni
// cuenta Zelle. Osmany le habia pedido los datos 30 segundos antes.
// Se mira lo acumulado de TODA la conversacion, no solo este lote.
// Para Zelle hacen falta NOMBRE Y CUENTA, igual que tarjeta Y celular. Con
// s.datos_zelle a secas, un Zelle a medias marcaba el destino como sabido y
// se saltaba la guarda entera: la rama de 'Zelle incompleto' era codigo
// muerto. Lo encontro una prueba end-to-end el 10-ago.
// Lo ACUMULADO, no solo lo de este lote: el nombre pudo llegar en un mensaje
// y la cuenta en otro, y el registro determinista ya los junto.
const zelleCompleto = !!(zelleNomCtx && zelleCtaCtx);
// Para una RECARGA el destino queda sabido con el numero a recargar, sin
// tarjeta: es la naturaleza del servicio, no una excepcion de la guarda.
// (291 follow-up) Mexico recipients live in remittance_beneficiaries without card or phone, so `tiene_beneficiario` and the
// card/phone test never see them: the note "TODAVIA NO HAY BENEFICIARIO REGISTRADO" told the model there was no recipient right
// after a deposit although the Mexico operation of the same send had two. They are counted here over ALL open operations of the
// send (`beneficiarios_registrados` is not limited to one operation); complete = has a name (the tool stores CLABE/bank with it).
const mxDestinatarios = regBen.filter((b) => b && /^mexico_/.test(String(b.t || '')) && String(b.nombre ?? '').trim() !== '');
const sabeDestino = !!((tarjetaCtx && celularCtx) || zelleCompleto || ctx.tiene_beneficiario || (recargaEnCurso && celularCtx) || (comboEnCurso && comboCompleto) || visaEnCurso || mxDestinatarios.length > 0);
// EL "ANOTADO" QUE NO ANOTA (14-ago-2026). Tres casos en cuatro dias en los
// que el sistema no registro NINGUN beneficiario y el modelo le dijo al
// cliente que si. Gardy dio "674 2713" — siete digitos, no es un celular
// cubano — y el extractor no lo vio; el modelo lo leyo en el texto crudo,
// se lo enseño, el cliente dijo "Si", y de ahi solo: "Anotado. Queda
// confirmado quien recibe en Cuba". No habia nada confirmado, y el envio se
// quedo con 5.000 GYD dentro y sin destinatario.
//
// POR QUE NO BASTABA LA GUARDA QUE YA HABIA: `sabeDestino` solo se mira
// dentro de `if (s.comprobante && !sabeDestino)`, o sea unicamente en el lote
// que trae el comprobante. En los tres casos el comprobante habia llegado
// lotes antes y la guarda ni se evaluaba.
//
// Va solo cuando hay datos A MEDIAS, que es cuando el modelo puede creerse
// que algo se guardo. Sin ningun dato no se pone: el cliente que solo saluda
// no necesita que le prohiban confirmar nada, y una nota de mas es ruido.
//
// LA REGLA DEL FORMATO VA AQUI DENTRO, no pegada a la nota de "Tarjeta cubana
// detectada". Dos motivos: su sitio logico es justo al lado de "el sistema
// rechazo ese dato", y ampliar la nota de al lado obligaba a permitir que
// desapareciera en el banco, que es debilitar la prueba para que pase.
// Per-operation recipient facts for a send with several open operations (mixed group / separate operations).
if (R && Array.isArray(R.operaciones)) {
  const abiertasR = R.operaciones.filter((o) => o && !['completed', 'cancelled'].includes(String(o.status)));
  if (abiertasR.length >= 2) {
    const nDest = (o) => {
      const sv = String(o.servicio || '');
      if (sv === 'mexico') {
        const n = mxDestinatarios.length;
        return n ? n + (n === 1 ? ' destinatario (' : ' destinatarios (') + mxDestinatarios.map((b) => String(b.nombre).trim() + (Number(b.monto) > 0 ? ' ' + Number(b.monto) + ' ' + (b.moneda || 'USD') : '')).join(', ') + ')' : 'ninguno';
      }
      if (sv === 'recarga') return o.celular ? '1' : 'ninguno';
      if (sv === 'efectivo_usd') return o.efectivo ? '1' : 'ninguno';
      if (sv === 'zelle') return o.zelle ? '1' : 'ninguno';
      if (sv === 'combo' || sv === 'visa' || sv === 'saldo') return o.celular ? '1' : 'ninguno';
      return o.tarjeta ? '1' : 'ninguno';
    };
    notas.push('DESTINATARIOS REGISTRADOS POR OPERACION (hechos del sistema, de todas las operaciones abiertas de este envio): ' + abiertasR.map((o) => String(o.servicio) + ': ' + nDest(o)).join('; ') + '. Una operacion con destinatarios NO esta sin destinatario aunque otra operacion de este envio si lo este; pide solo lo que falta de las que dicen ninguno.');
  }
}
const datosAMedias = !!(tarjetaCtx || celularCtx || zelleNomCtx || zelleCtaCtx);
if (!sabeDestino && !s.multi_beneficiario && datosAMedias) {
  const formato = (tarjetaCtx && !celularCtx)
    ? ' UN CELULAR CUBANO SON 8 DIGITOS Y EMPIEZA POR 5 O POR 63: si el numero que te dio no cumple eso, NO lo des por bueno aunque el cliente te lo confirme — dile que ese numero no es un celular cubano valido y pideselo otra vez.'
    : '';
  // (gate 83) The tools take partial data since gate 79: the note tells the model to save what it has NOW
  // (exec 304592: card alone, the old 'hasta que no esten los dos NO se registra nada' kept it from calling).
  // A customer waiting for a third party's data is not asked again (esperaTercero note): save, ask nothing.
