// se los mandaran. No es sordera del modelo: nadie se lo estaba diciendo.
const esperaTercero = /\b(estoy esperando|estoy en espera|espero que me (manden|envien|den|pasen)|en cuanto me (lo|los)? ?(manden|envien|den|pasen)|cuando me (lo|los)? ?(manden|envien|den|pasen)|me (lo|los) van a (mandar|enviar|dar|pasar)|(todavia|aun) no me (lo|los)? ?(han )?(mandado|enviado|dado|pasado)|no me (lo|los)? ?(han )?(mandado|enviado|dado|pasado) (todavia|aun))\b/i.test(texto);
