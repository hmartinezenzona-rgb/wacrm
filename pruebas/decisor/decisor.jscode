let tarjetaCtx = s.tarjeta, celularCtx = s.celular, veniaDeAntes = false;
let zelleNomCtx = s.zelle_nombre, zelleCtaCtx = (s.zelle_correo || s.zelle_celular);
try {
  const mb = $('Merge beneficiario').first().json;
  if (mb) {
    if (mb.tarjeta_final) { if (!s.tarjeta) veniaDeAntes = true; tarjetaCtx = mb.tarjeta_final; }
    if (mb.celular_final) { if (!s.celular) veniaDeAntes = true; celularCtx = mb.celular_final; }
    // Lo de Zelle tambien se acumula entre lotes desde la 077. Sin esto, con la
