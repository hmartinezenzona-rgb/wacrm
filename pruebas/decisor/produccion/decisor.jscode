const HORA_ABRE_MIN = ctx.horario_abre_min, HORA_CIERRA_MIN = ctx.horario_cierra_min;
const HORA_ABRE_TXT = ctx.horario_abre_texto, HORA_CIERRA_TXT = ctx.horario_cierra_texto;
const h = $('Historial contacto').first().json;
