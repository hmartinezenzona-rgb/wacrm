const accionAdmin = rutaAdminAccion(ctx, texto, tel);
if (accionAdmin) { return accionAdmin; }
if (ctx.bot_pausado) { return [{ json: { ruta: 'silencio', motivo: 'bot pausado a mano en esta conversacion' } }]; }
if (ctx.oculta) { return [{ json: { ruta: 'silencio', motivo: 'chat oculto por el operador' } }]; }
  if (ctx.asignado && !ctx.cierra_cortesia) { return [{ json: { ruta: 'silencio', motivo: 'chat asignado a humano' } }]; }
// Ventana de silencio: si una persona del equipo acaba de escribir, el bot
