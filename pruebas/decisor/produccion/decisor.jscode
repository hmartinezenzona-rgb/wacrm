    if (!zelleRegistrado && zelleNomCtx && zelleCtaCtx) {
      toolsPendientes.push('registrar_beneficiario_zelle con nombre "' + zelleNomCtx + '" y cuenta LITERAL "' + zelleCtaCtx + '"');
    }
    // (2026-10-28) Show the data as exact lines, and never talk about the transfer while a datum is missing.
    const lineasZelle = ['Cuenta Zelle anotada:']
      .concat(zelleNomCtx ? ['Nombre: ' + zelleNomCtx] : [])
      .concat(s.zelle_celular ? ['Celular: ' + s.zelle_celular] : [])
      .concat(s.zelle_correo ? ['Correo: ' + s.zelle_correo] : [])
      .concat(!s.zelle_celular && !s.zelle_correo && zelleCtaCtx ? ['Cuenta: ' + zelleCtaCtx] : [])
      .join(String.fromCharCode(10));
    const faltaZelle = !zelleNomCtx ? 'FALTA EL NOMBRE del titular' : (!zelleCtaCtx ? 'FALTA LA CUENTA (correo o celular de EEUU)' : '');
    notas.push('DATOS DE ZELLE DETECTADOS: ' + cuenta + '. ' + (zelleMixto ? 'El cliente quiere ZELLE y ADEMAS el resto en CUP/tarjeta: NO le digas que no hay CUP ni le prohibas pedir la tarjeta; confirma la cuenta Zelle y pide la tarjeta y el celular de la parte CUP.' : 'Este cliente quiere ZELLE (no CUP ni tarjeta Clasica/Tropical). PROHIBIDO pedirle tarjeta ni celular cubano.') + ' Confirmaselos COPIADOS TAL CUAL, sin cambiar ni un caracter, uno por linea (Etiqueta: valor), sin negrita. El NOMBRE de la cuenta es OBLIGATORIO: si no lo ha dado, pideselo.' + (zelleRegistrado ? ' YA ESTA REGISTRADO EN EL TABLERO: NO hay ninguna tool que llamar para esto, solo confirmaselo con palabras.' : ' NO ESTA REGISTRADO TODAVIA. Llama registrar_beneficiario_zelle EN ESTE MISMO TURNO con lo que haya (el nombre y/o la cuenta, la cuenta LITERAL tal como esta aqui arriba) y pide lo que falte.') + (faltaZelle ? ' ' + faltaZelle + ': PROHIBIDO decir "una vez hecha su remesa", "le notificamos" ni hablar de cuando se hace: sin ese dato no se puede hacer. Termina con UNA sola pregunta, la de ese dato.' : '') + ' Muestra al cliente EXACTAMENTE estas lineas, cada una en su linea:' + String.fromCharCode(10) + lineasZelle);
  }
