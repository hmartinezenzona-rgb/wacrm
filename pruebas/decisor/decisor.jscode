// (gate 78, 2026-10-01) "YA ESTA REGISTRADO" only for the datum detected in this turn.
// `Contexto conversacion` lists the vigente beneficiaries of the open operations; the old flag
// (tiene_beneficiario: ANY complete beneficiary) told the model a new Zelle was registered when
// another one was, and the model obeyed and wrote nothing (gate 77: 0/30 -> 25/30 once the
// sentence is true). Without the list (an older Contexto) the Cuban branch keeps its old
// behaviour (the old flag) in both branches.
const regBenDisponible = Array.isArray(ctx.beneficiarios_registrados);
const regBen = regBenDisponible ? ctx.beneficiarios_registrados : [];
const normCta = (x) => { const t = String(x ?? '').trim().toLowerCase(); if (t.includes('@')) return t;
  const d = t.replace(/\D/g, ''); return (d.length === 11 && d[0] === '1') ? d.slice(1) : d; };
const normNom = (x) => String(x ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
const soloDig = (x) => String(x ?? '').replace(/\D/g, '');
const zelleRegistrado = regBenDisponible
  ? (!!zelleCtaCtx && regBen.some((b) => b.t === 'zelle'
      && normCta(b.cuenta) === normCta(zelleCtaCtx) && (!zelleNomCtx || normNom(b.nombre) === normNom(zelleNomCtx))))
  : !!ctx.tiene_beneficiario;
const cubanoRegistrado = !!(tarjetaCtx && celularCtx) && regBen.some((b) => b.t !== 'zelle'
  && soloDig(b.tarjeta) === soloDig(tarjetaCtx) && soloDig(b.celular).slice(-8) === soloDig(celularCtx).slice(-8));
// (gate 82, 2026-10-02) REPARTO EN CURSO, MONTO EN GYD DE UN REPARTO Y MINIMOS DE DEPOSITO.
// Staging test 2 (2026-10-02 03:36 UTC): two cards, one phone, "5 mil a cada una". With the reparto
// saved, the later bursts are not multi_beneficiario, and the accumulated card + phone (Merge
// beneficiario) sent the model to gestionar_beneficiario, which replaced the reparto by one card.
// Migration 184 refuses that in the DB; this note keeps the model on registrar_reparto_multiple.
// The amount "5 mil a cada una" was ignored: the deposit minimums were not in the context, so the
// model could not tell that 5,000 GYD per card only fits a CUP remesa (Clasica/Tropical start at
// 13,000). The minimums come from cerebro_config through `Contexto conversacion` (ctx.minimos).
const g82TiposReparto = ['multiple_distribution', 'clasica', 'tropical'];
const g82Slots = regBen.filter((b) => g82TiposReparto.includes(b.t) && Number(b.posicion) >= 1 && Number(b.posicion) <= 3)
  .sort((a, b) => Number(a.posicion) - Number(b.posicion));
const g82RepartoVigente = g82Slots.length >= 2;
const g82N = (x) => Number(x).toLocaleString('en-US');
const g82Recibe = (b) => (b.monto == null ? null
  : (b.t === 'multiple_distribution' ? g82N(b.monto) + ' CUP' : g82N(b.monto) + ' USD ' + (b.t === 'clasica' ? 'Clasica' : 'Tropical')));
const g82NotaReparto = () => {
  const faltas = [];
  const lineas = g82Slots.map((b) => {
    const k = b.posicion;
    if (!b.tarjeta) faltas.push('la tarjeta ' + k);
    if (!b.celular) faltas.push('el celular de la tarjeta ' + k);
    if (b.monto == null) faltas.push('cuanto recibe la tarjeta ' + k);
    return k + ') tarjeta ' + (b.tarjeta || '(falta)') + ', celular ' + (b.celular || '(falta)') + ', recibe ' + (g82Recibe(b) || '(falta)');
  });
  return 'REPARTO EN CURSO entre ' + g82Slots.length + ' tarjetas. Guardado ahora: ' + lineas.join('; ') + '. '
    + (faltas.length ? 'FALTA: ' + faltas.join(', ') + '. Pidelo con naturalidad, UNA pregunta por mensaje. '
                     : 'Esta COMPLETO: confirmaselo al cliente con todos los datos en *negrita*. ')
