// que llamarla aqui es valido y evita mover 60 lineas de sitio.
const accionAdmin = rutaAdminAccion(ctx, texto, tel);
if (accionAdmin) { return accionAdmin; }
if (ctx.bot_pausado) { return [{ json: { ruta: 'silencio', motivo: 'bot pausado a mano en esta conversacion' } }]; }
if (ctx.oculta) { return [{ json: { ruta: 'silencio', motivo: 'chat oculto por el operador' } }]; }
  if (ctx.asignado && !ctx.cierra_cortesia) { return [{ json: { ruta: 'silencio', motivo: 'chat asignado a humano' } }]; }
// Ventana de silencio: si una persona del equipo acaba de escribir, el bot
// se calla 5 minutos para no pisarle la conversacion ni contradecirla.
// Pasada la ventana retoma solo, sin que nadie tenga que liberar nada.
if (ctx.humano_reciente) { return [{ json: { ruta: 'silencio', motivo: 'un humano del equipo acaba de escribir' } }]; }
// UN ADMIN SIN ACCION RECONOCIDA NO ES UN CLIENTE (18-ago-2026, doc 44).
// Va ANTES de la rama de cortesia a proposito: hasta hoy, un admin que escribia
// 'hola' en un chat asignado con cortesia pendiente entraba en la rama del
// modelo (comprobado: CTRL-06 y CTRL-12 daban `agente`). El plano de control no
