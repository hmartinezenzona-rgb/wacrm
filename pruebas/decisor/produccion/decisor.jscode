  const numeros = (texto.replace(/(?<=\d)[ ,.](?=\d)/g, '').match(/\b\d{3,7}\b/g) || []);
  const mil = /(\d+)\s*(mil|k)\b/i.test(t);
  const pesosSinApellido = /\b\d+(?:[.,]\d+)?\s*(mil|k)?\s*pesos\b/i.test(texto) && !/pesos\s+cubanos?/i.test(texto) && !/pesos\s+(guyaneses|gy|gyd)/i.test(texto);
  const PESOS_GYD = ' El cliente dijo "X pesos" sin apellido: son GYD que DEPOSITA (minimo 5,000 GYD); NO preguntes CUP vs GYD ni uses calcular_inverso.';
  if (!g83Destinos.length && (pideLlegada || pideDeposito) && (numeros.length || mil)) {
    if (pideDeposito && !pideLlegada) {
      notas.push('CALCULO A HACER (ya resuelto por el sistema, no lo replantees): el cliente pide que LLEGUEN ese monto a Cuba, o sea es el monto de DESTINO en CUP. Usa calcular_inverso con ese numero. Al responder di: "Para que lleguen *X CUP* necesita depositar *Y GYD*."');
    } else if (pideLlegada) {
      notas.push('CALCULO A HACER (ya resuelto por el sistema, no lo replantees): el cliente pregunta CUANTO LLEGA, o sea el monto que dijo es lo que EL DEPOSITA, en GYD, aunque la transcripcion diga otra moneda. Usa calcular_envio con ese numero. Al responder di: "Por *X GYD* llegan *Y CUP* a Cuba."' + (pesosSinApellido ? PESOS_GYD : ''));
    }
  } else if (!g83Destinos.length && pesosSinApellido && !pideDeposito && (!ctx.riel_operacion || String(ctx.riel_operacion) === 'cuban_card')) {
    // "X pesos" sin apellido en una sola remesa: GYD que DEPOSITA, por la via de la tarjeta en CUP.
    notas.push('CALCULO A HACER (ya resuelto por el sistema, no lo replantees): la via es CUP (tarjeta en pesos) y el monto que dijo es lo que EL DEPOSITA, en GYD. Usa calcular_envio con ese numero. Al responder di: "Por *X GYD* llegan *Y CUP* a Cuba."' + PESOS_GYD);
  }
} catch (e) {}

// Horario de atencion: lunes a sabado, apertura y cierre de cerebro_config (136). Domingo CERRADO
// todo el dia. Se calcula en America/Guyana, igual que el resto del Cerebro.
// Fuera de horario NO se deja de atender: solo se avisa en una linea.
const ahoraGy = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Guyana' }));
const diaGy = ahoraGy.getDay(); // 0 = domingo
const minGy = ahoraGy.getHours() * 60 + ahoraGy.getMinutes();
// DIAS CERRADOS (205/101, 3-oct-2026, aniversario del lunes 5): un dia de 'dias_cerrados' es FUERA DE HORARIO todo
// el dia, con su motivo; y si antes del proximo dia habil cae un dia cerrado, se promete ese proximo dia habil.
const ce = (ctx.cierre_especial && typeof ctx.cierre_especial === 'object') ? ctx.cierre_especial : {};
const hoyCerrado = ce.hoy_motivo || null;
const proximoHabil = ce.proximo_habil || null;
const avisoCierre = ce.proximo_cierre || null;
// Turno con deposito o transferencia: comprobante, envio por verificar o listo para transferir, o el cliente los nombra.
const turnoConDeposito = !!s.comprobante || !!(h && (h.etapa_envio_abierto === 'Por verificar' || h.etapa_envio_abierto === 'Lista para transferir')) || /deposit|transfer|comprobante|transid/i.test(texto);
const LINEA_HORARIO_OBLIGATORIA = turnoConDeposito ? ' OBLIGATORIO: este turno trata de un deposito o una transferencia, asi que tu respuesta DEBE incluir la linea del horario: "queda registrado y se procesa a partir de las ' + HORA_ABRE_TXT + ' (hora de Guyana)". Sin esa linea la respuesta esta incompleta.' : '';
const abierto = diaGy !== 0 && minGy >= HORA_ABRE_MIN && minGy < HORA_CIERRA_MIN && !hoyCerrado;
// PROXIMO A CERRAR va PRIMERO y NO depende de `abierto`: lo calcula el SQL de
// `Contexto conversacion` con el reloj de la BASE y la clave de configuracion
// `cierre_aviso_minutos` (30 hoy; 0 lo apaga). Dos motivos: el reloj de Postgres
// es mas fiable que el del contenedor, y asi la rama se puede PROBAR en el banco
// a cualquier hora — con el reloj del proceso solo se podria probar entre las
// 16:30 y las 17:00, que es como no probarla.
// Si por desfase de relojes llegaran los dos a la vez, gana este: los dos dicen
// "sigue atendiendo pero no prometas la transferencia", asi que el fallo es benigno.
if (ctx.por_cerrar && !hoyCerrado) {
  notas.push('PROXIMO A CERRAR: hoy ya vamos cerrando (' + hora + ' en Guyana; se cierra a las ' + HORA_CIERRA_TXT + '). SIGUE ATENDIENDO CON NORMALIDAD: cotiza, pide los datos, registra el deposito y confirma que esta verificado, igual que siempre. Lo UNICO que cambia es la promesa de la TRANSFERENCIA: PROHIBIDO decir "en breve" o "enseguida", porque hoy ya no sale. Di en UNA sola linea natural que su envio queda registrado y se procesa a partir de las ' + HORA_ABRE_TXT + ' (hora de Guyana) del siguiente dia habil.' + (proximoHabil ? ' El siguiente dia habil es ' + proximoHabil + (avisoCierre ? ' (' + avisoCierre + '): dilo asi y avisale de ese cierre en la misma linea.' : '.') : ' Si hoy es sabado, el siguiente dia habil es el LUNES, porque el domingo esta cerrado.'));
} else if (hoyCerrado) {
  const diaHoyTxt = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'][diaGy];
  notas.push('FUERA DE HORARIO: HOY NO SE TRABAJA EN TODO EL DIA (' + hoyCerrado + '; ' + hora + ' en Guyana). Agrega UNA sola linea natural avisandolo y SIGUE ATENDIENDO NORMAL: cotiza, registra y responde igual que siempre. Dilo asi o casi igual (frase del dueno): "Hoy ' + diaHoyTxt + ' no estamos trabajando ' + hoyCerrado + '; por aqui le atendemos igual y lo pendiente queda registrado y se procesa ' + (proximoHabil || 'el proximo dia habil') + ' a partir de las ' + HORA_ABRE_TXT + ' (hora de Guyana)." PROHIBIDO decir que no puedes atender. PROHIBIDO decir "en breve" o "enseguida".' + LINEA_HORARIO_OBLIGATORIA);
} else if (!abierto) {
  notas.push('FUERA DE HORARIO: ahora mismo el negocio esta cerrado (' + hora + ' en Guyana). Agrega UNA sola linea natural avisando de que estamos fuera de horario y SIGUE ATENDIENDO NORMAL: cotiza, registra y responde igual que siempre. El horario real es de lunes a sabado de ' + HORA_ABRE_TXT + ' a ' + HORA_CIERRA_TXT + ' hora de Guyana, y los domingos cerrado. PROHIBIDO inventarse otros horarios o decir que no se puede atender. Y OJO CON LO QUE PROMETES: PROHIBIDO decir "en breve" o "enseguida" para la transferencia, porque no se va a hacer hasta que abran. Di que queda registrado y se procesa a partir de las ' + HORA_ABRE_TXT + ' (hora de Guyana).' + (avisoCierre ? ' OJO: ' + avisoCierre + ', asi que abrimos ' + proximoHabil + ': di que queda registrado y se procesa ' + proximoHabil + ' a partir de las ' + HORA_ABRE_TXT + ' (hora de Guyana) y avisale de ese cierre en la misma linea.' : '') + LINEA_HORARIO_OBLIGATORIA);
} else {
  // ANCLA POSITIVA DE HORARIO (14-ago-2026). Hasta hoy este if/else-if no tenia
  // rama para "abierto": cuando el negocio estaba abierto el contexto NO decia
  // NADA del horario. Y contra ese silencio empujaban dos cosas:
  //   1. Los unicos ejemplos que trae el prompt de la confirmacion "comprobante
  //      verificado + beneficiario registrado" son de FUERA DE HORARIO, y los
  //      dos acaban en "En cuanto abramos, a partir de las 9:00am". No hay ni
  //      un ejemplo EN horario de ese mismo mensaje.
  //   2. La memoria de la conversacion, que puede traer turnos reales de un dia
  //      anterior en los que si estaba cerrado.
  // Resultado: Adrismir el 14-ago a las 14:33 y Javier el 13-ago a las 11:56,
  // los dos con el negocio ABIERTO, oyeron "se la hacemos en cuanto abramos".
  // Es el mismo patron que el idioma: la regla solo hablaba en un sentido.
  //
  // LA ULTIMA FRASE NO SOBRA. Sin ella esta nota choca de frente con la guarda
  // de "no prometas la transferencia sin beneficiario", y dos notas que se
  // contradicen es como se perdieron 27 minutos el 10-ago.
  notas.push('EL NEGOCIO ESTA ABIERTO AHORA MISMO (' + hora + ' en Guyana). PROHIBIDO decir "en cuanto abramos", "cuando abramos", "a partir de las ' + HORA_ABRE_TXT + '", "queda para manana" ni ninguna formula que aplace algo a otro dia o a la hora de apertura: hoy se esta trabajando. PROHIBIDO decir o dar a entender que estamos cerrados o fuera de horario. OJO: esto NO te obliga a prometer nada. Si otra nota te prohibe prometer la transferencia, esa manda.');
}
// AUSENCIA TEMPORAL (away mode, 264): the owner is out for a while. Only while the business is open: out of
// hours or on a closed day the note above already says when work resumes. Defensive on every field.
const aus = (ce.ausencia && typeof ce.ausencia === 'object') ? ce.ausencia : null;
if (aus && aus.motivo && aus.hasta_texto && abierto) {
  if (h && h.primer_del_dia) {
    notas.push('AUSENCIA TEMPORAL: ahora mismo los encargados no estan disponibles (' + aus.motivo + '); regresan ' + aus.hasta_texto + ' hora de Guyana. Los ausentes son LOS ENCARGADOS, no tu: tu sigues aqui. Agrega UNA sola linea natural avisandolo y SIGUE ATENDIENDO NORMAL: cotiza, pide los datos, registra y responde igual que siempre. Dilo asi o casi igual: "Ahora mismo los encargados no estan disponibles ' + aus.motivo + '; regresan ' + aus.hasta_texto + '. Por aqui le seguimos atendiendo y lo suyo queda registrado y se procesa a partir de que regresen." PROHIBIDO decir que no puedes atender. PROHIBIDO decir "en breve" o "enseguida" para la transferencia antes de que regresen.');
  } else {
    // The full notice was already given today; only the guard remains. This is the root fix for
    // the repeated away notice measured on 2026-10-25/26.
    notas.push('AUSENCIA YA AVISADA HOY: NO repitas que los encargados no estan disponibles, ni el motivo, ni la hora de regreso. Si el cliente pregunta si hay posibilidad hoy, di en UNA frase "Hoy no se lo puedo prometer" o "no depende de mi", sin repetir el motivo. Si el deposito ya esta verificado, dilo; no prometas una hora exacta. Si no pregunta, atiende normal y no menciones la ausencia.');
  }
}
if (s.multi_beneficiario) {
  const nt = (s.tarjetas || []).length;
  notas.push('ENVIO A VARIOS BENEFICIARIOS: el cliente dio ' + nt + ' tarjetas (' + (s.tarjetas || []).join(', ') + ')' + ((s.celulares || []).length ? ' y estos celulares (' + s.celulares.join(', ') + ')' : ' y ningun celular todavia') + '. NO se registro nada automaticamente. ESTO LO ATIENDES TU: NO llames derivar_humano. Faltan dos cosas y las pides con naturalidad, UNA pregunta por mensaje: el celular que corresponde a cada tarjeta, y CUANTOS CUP recibe cada persona. Llama registrar_reparto_multiple YA con lo que tengas (cadena vacia en lo que falte) y otra vez con cada dato nuevo; pide lo que la herramienta diga que FALTA. Si el cliente quiere repartir entre MAS DE 3 personas, ahi si llama derivar_humano.');
  if (g82RepartoVigente) notas.push(g82NotaReparto());
} else if (g82RepartoVigente) {
  notas.push(g82NotaReparto());
} else if (tarjetaCtx && celularCtx && regBenDisponible && !cubanoRegistrado) {
  notas.push('TARJETA Y CELULAR DETECTADOS PERO NO REGISTRADOS: tarjeta ' + tarjetaCtx + ' y celular ' + celularCtx + '. Todavia NO estan guardados en el envio. Llama gestionar_beneficiario EN ESTE MISMO TURNO con esos datos y confirmaselos al cliente con la tarjeta y el celular COMPLETOS, uno por linea (Tarjeta: ... / Celular: ...), sin negrita. PROHIBIDO decir anotado sin haber llamado la herramienta.' + ' Muestra EXACTAMENTE estas lineas:' + String.fromCharCode(10) + 'Tarjeta: ' + tarjetaCtx + String.fromCharCode(10) + 'Celular: ' + celularCtx);
} else if (tarjetaCtx && celularCtx) {
  if (soloAcuse) {
    notas.push('Beneficiario YA REGISTRADO automaticamente en el tablero: tarjeta ' + tarjetaCtx + ' y celular ' + celularCtx + '. El cliente solo acusa recibo: responde en UNA frase corta confirmando que quedo registrado; NO repitas tarjeta ni celular si ya se confirmaron en el turno anterior.');
  } else if (veniaDeAntes && !s.tarjeta && !s.celular) {
    // Both came in earlier batches, so the pair was already confirmed. If one arrives in THIS batch the pair is
