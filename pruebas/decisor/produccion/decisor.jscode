// de un try/catch, y SOLO si no ha salido antes por liberar/tasa/ver_tasas/
// dup_etapa. Pasarlo por parametro obligaria a consultar el nodo SIEMPRE —
// tambien para un `liberar`— y eso ya seria cambiar el comportamiento. `$` sale
// del ambito de fuera, igual que antes.
// YA NO VA DESPUES DE LAS GUARDAS (18-ago-2026, doc 44). Hasta hoy este comentario
// decia lo contrario, y era cierto: un admin en un chat pausado, oculto, asignado o
// con un humano recien escribiendo perdia su comando en silencio. Eso se corrigio en
// esta microfase — la ACCION reconocida se evalua arriba del todo—, asi que la frase
// se actualiza en vez de dejarla mintiendo. El FALLBACK de admin sin accion si sigue
// despues de las guardas.
// IDIOMA DE LA CONVERSACION — extraido a funcion el 19-ago-2026 (doc 57).
// EXTRACCION PURAMENTE ESTRUCTURAL: condicion, umbrales, los dos vocabularios
// y el texto de la nota son byte a byte los de antes. Lo unico que cambia es
// que vive en una funcion en vez de en cuatro `const` sueltos a mitad del
// Decisor. Se declara aqui, como `rutaAdminAccion`, y se llama arriba: las
// declaraciones `function` se elevan.
//
// Devuelve la NOTA (string) o null. No decide rutas, no toca la base, no llama
// a herramientas y no depende de nada mas que sus dos argumentos.
function notaIdioma(muestra, texto) {
  const muestraIdioma = ((muestra || '') + ' ' + texto).toLowerCase();
  const cuentaIdioma = re => (muestraIdioma.match(re) || []).length;
  // Palabras sin ambiguedad entre los dos idiomas: nada de "no", "me", "son",
  // "es" ni "si", que existen en ambos y ensucian el recuento.
  const nEn = cuentaIdioma(/\b(the|you|your|and|are|is|was|were|how|what|when|where|which|can|could|would|should|please|thanks|thank|hello|good|morning|afternoon|evening|night|account|send|money|number|need|want|have|has|will|from|with|for|that|this|there|here|about|more|only|yes|does|been|they|but|just|okay|sorry|friend|check|transfer|deposit|card|phone|today|tomorrow|much|know|tell|something|understand|receive|receiver|name|first|last|then|also|still|again)\b/g);
  const nEs = cuentaIdioma(/\b(que|qué|para|por|con|una|unas|unos|del|las|los|como|cómo|dónde|donde|cuánto|cuanto|gracias|hola|buenas|buenos|días|dias|tardes|noches|cuenta|dinero|tarjeta|celular|número|numero|envío|envio|enviar|depósito|deposito|depositar|puedo|quiero|necesito|está|esta|estoy|hacer|manda|mandar|cuándo|cuando|quién|quien|porque|también|tambien|pero|muy|bien|señor|usted|mi|su|le|ya|todavía|todavia|ahora|dime|dígame|digame|mismo|otra|nada)\b/g);
  if (nEn >= 3 && nEn > nEs * 2) {
    return 'IDIOMA DE ESTA CONVERSACION: INGLES. El cliente viene escribiendo en ingles. TU RESPUESTA VA ENTERA EN INGLES — saludo, datos, preguntas y cierre — aunque el mensaje de ESTE lote sea corto, sea solo un numero, o no se le note el idioma. Y aunque TODAS estas notas esten escritas en español: son instrucciones para ti, NO un modelo del idioma en el que tienes que contestar. El idioma lo fija la CONVERSACION, no el ultimo mensaje.';
  }
  return null;
}


function rutaAdminAccion(ctx, texto, tel) {
  // Devuelve una ACCION ADMINISTRATIVA RECONOCIDA, o null. El `silencio` de
  // 'mensaje del admin' YA NO vive aqui: se movio fuera (18-ago-2026, doc 44).
  // Separarlos es lo que permite que la accion salte las guardas sin que el
  // fallback se las salte tambien.
  if (!ctx.es_admin) { return null; }
  // Comandos de admin por WhatsApp:
  //   liberar <numero>       -> devuelve el chat al bot
  //   tasa <moneda> <valor>  -> actualiza la tasa del dia (ej: "tasa gyd 2.1")
  const cmd = texto.match(/^\s*liberar\s+\+?([0-9]{8,15})\s*$/i);
  if (cmd) { return [{ json: { ruta: 'comando', comando: 'liberar', objetivo: cmd[1], valor: null, telefono_e164: tel } }]; }
  // Acepta coma o punto decimal: "tasa gyd 2,1" y "tasa gyd 2.1" valen igual.
  const cmdTasa = texto.match(/^\s*tasa\s+(gyd|mxn|usd)\s+([0-9]+(?:[.,][0-9]+)?)\s*$/i);
  if (cmdTasa) { return [{ json: { ruta: 'comando', comando: 'tasa', objetivo: cmdTasa[1].toLowerCase(), valor: cmdTasa[2].replace(',', '.'), telefono_e164: tel } }]; }
  // "tasa" o "tasas" a secas: solo consulta, no escribe nada.
  if (/^\s*tasas?\s*$/i.test(texto)) { return [{ json: { ruta: 'comando', comando: 'ver_tasas', objetivo: '', valor: null, telefono_e164: tel } }]; }
  // VERIFICAR COMPROBANTE (11-ago): el admin reenvia un comprobante y recibe
  // el veredicto del SQL en seco, sin guion de cliente. Deterministico: el
  // texto sale de cerebro_cruzar_deposito, el modelo no interviene.
  // Comprobante REPETIDO (11-ago): el dedup ya evito el deal duplicado rio
  // arriba; aqui solo se le informa al admin del estado real, en seco.
  if (ctx.dup_etapa) {
    const dupTxt = 'YA REGISTRADO: ese comprobante ya tiene su deal.' + String.fromCharCode(10)
      + 'Etapa: ' + ctx.dup_etapa
      + (ctx.dup_valor ? (String.fromCharCode(10) + 'Importe: ' + ctx.dup_valor + ' GYD') : '')
      + String.fromCharCode(10) + 'No se creo nada nuevo.';
    return [{ json: { ruta: 'comando', comando: 'verificar', objetivo: dupTxt, valor: null, telefono_e164: tel } }];
  }
  let cruceAdm = null;
  try { cruceAdm = $('Cruzar deposito con MMG').first().json ?? null; } catch (e) {}
  if (cruceAdm && cruceAdm.resultado) {
    let montoAdm = null, refAdm = null;
    try { const snAdm = $('Snapshot final').first().json.comprobante || {}; montoAdm = snAdm.monto ?? null; refAdm = snAdm.referencia ?? null; } catch (e) {}
    const vAdm = String(cruceAdm.resultado);
    const nlAdm = String.fromCharCode(10);
    let tAdm;
    if (vAdm === 'verificado') {
      tAdm = 'VERIFICADO: casa con el correo de MMG.' + nlAdm
        + 'TransID: ' + (cruceAdm.trans_id || refAdm || '?') + nlAdm
        + (montoAdm ? ('Importe: ' + montoAdm + ' GYD' + nlAdm) : '')
        + 'Metodo: ' + (cruceAdm.metodo || 'exacto') + nlAdm
        + 'El deposito queda consumido.';
    } else if (vAdm === 'ya_reclamado') {
      tAdm = 'YA RECLAMADO: ese deposito ya se uso en otro envio.' + nlAdm
        + 'TransID: ' + (cruceAdm.trans_id || refAdm || '?');
    } else if (vAdm === 'verificado_incompleto' || vAdm === 'verificado_de_mas') {
      // El deposito SI cruzo; lo que pasa es que no cuadra con el objetivo del
      // envio. Sin esto caeria en el `else` y le diria a Osmany "no casa con
      // ningun correo de MMG", que es falso.
      tAdm = (vAdm === 'verificado_incompleto' ? 'VERIFICADO PERO INCOMPLETO' : 'VERIFICADO Y SOBRA DINERO')
        + ': casa con el correo de MMG.' + nlAdm
        + 'TransID: ' + (cruceAdm.trans_id || refAdm || '?') + nlAdm
        + 'Objetivo: ' + (cruceAdm.objetivo ?? '?') + ' GYD' + nlAdm
        + 'Lleva depositado: ' + (cruceAdm.depositado ?? '?') + ' GYD' + nlAdm
        + (Number(cruceAdm.saldo) > 0
             ? ('FALTAN ' + cruceAdm.saldo + ' GYD. El envio sigue esperando.')
             : ('SOBRAN ' + Math.abs(Number(cruceAdm.saldo)) + ' GYD. Lo mira una persona.'));
    } else if (vAdm === 'deposito_antiguo') {
      tAdm = 'DEPOSITO ANTIGUO: mas de 72 horas. NO se consumio; hay que mirarlo a mano.' + nlAdm
        + 'Ref leida: ' + (refAdm || '?');
    } else {
      tAdm = 'SIN CRUCE (' + vAdm + '): no casa con ningun correo de MMG.' + nlAdm
        + 'Ref leida: ' + (refAdm || 'no se pudo leer')
        + (montoAdm ? (nlAdm + 'Importe leido: ' + montoAdm + ' GYD') : '');
    }
    return [{ json: { ruta: 'comando', comando: 'verificar', objetivo: tAdm, valor: null, telefono_e164: tel } }];
  }
  // TRANSID ESCRITO (312): el admin manda solo el numero, o "verifica 123...", o "transid: 123...".
  // El cruce con el correo de MMG lo hace cerebro_verificar_transid; aqui solo se enruta.
  const mTrans = texto.match(/\b(?:transid|transaccion|verifica(?:me|r)?|comprobante)\b[^0-9]{0,12}(\d{10,20})\b/i)
    || texto.trim().match(/^(\d{10,20})$/);
  if (mTrans) {
    return [{ json: { ruta: 'comando', comando: 'verificar_transid', objetivo: mTrans[1], valor: null, telefono_e164: tel } }];
  }
  return null;   // admin sin accion reconocida: lo resuelve la guarda de mas arriba
}
// Datos del beneficiario ACUMULADOS a lo largo de la conversacion (no solo de este lote).
