// Estado exacto del envio abierto: para responder con precision a "como va lo mio"
// S4: the stage of the open send comes from the resolved holder operation; the contact history is the legacy alias.
const etapaR = (() => {
  if (!R || !Array.isArray(R.operaciones)) return null;
  const abiertas = R.operaciones.filter((o) => o && o.status && !['completed', 'cancelled'].includes(String(o.status)));
  const titular = abiertas.find((o) => rielR && String(o.servicio) === rielR) || abiertas[0];
  if (!titular) return null;
  return ({ collecting_information: 'Solicitada', awaiting_deposit: 'Solicitada', deposit_verification: 'Por verificar', ready_to_transfer: 'Lista para transferir', incident: 'Incidencia' })[String(titular.status)] || null;
})();
const etapaAbierta = etapaR || (h && h.etapa_envio_abierto) || null;
if (etapaAbierta) {
  const et = etapaAbierta;
  const monto = h && h.monto_envio_abierto ? (' (' + h.monto_envio_abierto + ')') : '';
  let est = null;
  if (et === 'Solicitada') { est = 'ESTADO REAL DEL ENVIO EN CURSO: anotado, pero su deposito TODAVIA NO HA LLEGADO. Si el cliente pregunta como va lo suyo, dile que estan pendientes de recibir el deposito. NO digas que se esta verificando: no hay nada que verificar aun.'; }
  else if (et === 'Por verificar') { est = 'ESTADO REAL DEL ENVIO EN CURSO' + monto + ': el deposito YA LLEGO y esta EN VERIFICACION. Si el cliente pregunta como va lo suyo, dile que lo estan verificando y que apenas quede le hacen la transferencia.'; }
  else if (et === 'Lista para transferir') { est = 'ESTADO REAL DEL ENVIO EN CURSO' + monto + ': el deposito YA FUE VERIFICADO y la transferencia esta por hacerse. Si el cliente pregunta como va lo suyo, dile que ya quedo verificado y que la transferencia sale enseguida. SIGUE sin poder confirmar que ya se envio: eso lo confirma el operador.'; }
  else if (et === 'Incidencia') { est = 'ESTADO REAL DEL ENVIO EN CURSO' + monto + ': hay una INCIDENCIA y un operador la esta revisando. Si el cliente pregunta como va lo suyo, dile con calma que lo estan revisando y que le confirman en cuanto quede. NO inventes el motivo ni prometas tiempos.'; }
  // NO CONTRADECIR LA GUARDA DE BENEFICIARIO.
  // El 10-ago esta nota decia "la transferencia sale enseguida" mientras la
  // guarda de mas arriba decia "PROHIBIDO decir que le vas a hacer la
  // transferencia". Dos ordenes opuestas en el mismo contexto: el modelo se
  // quedo con la que prometia. El fallo era del contexto, no del modelo.
  if (est && !sabeDestino) {
    est = est
      .replace(' Si el cliente pregunta como va lo suyo, dile que lo estan verificando y que apenas quede le hacen la transferencia.',
               ' Si el cliente pregunta como va lo suyo, dile que lo estan verificando.')
      .replace(' y la transferencia esta por hacerse.', '.')
      .replace(' Si el cliente pregunta como va lo suyo, dile que ya quedo verificado y que la transferencia sale enseguida.',
               ' Si el cliente pregunta como va lo suyo, dile que ya quedo verificado.')
      + ' OJO: TODAVIA NO SE SABE A QUIEN TRANSFERIRLE, asi que PROHIBIDO decir que la transferencia sale enseguida, que se hace en breve o que se hara apenas se verifique. Primero pidele los datos de quien recibe.';
  }
  // RECARGA: el mismo estado, dicho con la palabra del servicio. Para el
  // cliente una "transferencia" es dinero a una tarjeta; lo suyo es una recarga.
  if (est && recargaEnCurso) {
    est = est.replace(/la transferencia/g, 'la recarga')
             .replace('A QUIEN TRANSFERIRLE', 'EL NUMERO A RECARGAR')
             .replace('Primero pidele los datos de quien recibe.', 'Primero pide el numero a recargar.');
  }
  // COMBO: the same state, said with the service's words; a combo is never sent 'enseguida': a person calls first.
  if (est && comboEnCurso) {
    est = est.replace('la transferencia sale enseguida', 'una persona del equipo le llama para elegir los productos y despues se envia su combo')
             .replace(/la transferencia/g, 'el envio del combo')
             .replace('A QUIEN TRANSFERIRLE', 'LOS DATOS DEL DESTINATARIO DEL COMBO')
             .replace('Primero pidele los datos de quien recibe.', 'Primero pide los datos del destinatario del combo.');
  }
  // VISA: the state said with the service's words; nothing is transferred, the team uploads the application.
  if (est && visaEnCurso) {
    est = est.replace('la transferencia sale enseguida', 'el equipo sube su aplicacion de extension de visa y le avisamos por aca')
             .replace(/la transferencia/g, 'la aplicacion de la visa');
  }
  if (est && anotadaPara) { est = est.replace('la recarga sale enseguida', 'la recarga se hace el ' + anotadaPara + ', cuando empieza la promocion de Etecsa'); }
  if (est) { notas.push(est + ' Menciona el estado SOLO si el cliente pregunta por el; no lo sueltes por iniciativa propia.'); }
}
if (anotadaPara) {
  notas.push('RECARGA ANOTADA PARA EL ' + anotadaPara + ': la promocion de Etecsa empieza ese dia y la recarga se hace ese dia. PROHIBIDO decir que se hace hoy, enseguida, en breve, en minutos o en cuanto abramos. Si el cliente ya pago, confirmale el deposito como siempre y dile que su recarga se hace el ' + anotadaPara + '. Si no ha pagado, puede pagar ahora o ese dia, como prefiera: no se lo exijas.');
}
if (toolsPendientes.length) {
  notas.push('TOOL OBLIGATORIA EN ESTE TURNO: ' + toolsPendientes.join('. TOOL OBLIGATORIA EN ESTE TURNO: ') + '. Llamala UNA sola vez en este mismo turno. Ademas, respondele al cliente.');
}
// MLC: NO SE COTIZA (084). El MLC no esta en `cerebro_servicios` ni tiene tasa
// en `tasas`, asi que preguntado por el, el modelo caia en la del DOLAR: el
// 12-ago cotizo 13 MLC y el 13-ago 40 MLC, las dos a 260 GYD por unidad.
// Va la ULTIMA de las notas A PROPOSITO: es la que tiene que ganar si choca con
// cualquier otra instruccion de cotizar (25-la-colision-de-instrucciones).
// Y el aviso al admin NO depende de esta nota: lo dispara `Control de abuso` en
// SQL, antes del modelo, asi que sale aunque el modelo desobedezca.
if (ctx.pide_mlc) {
  notas.push('EL CLIENTE PREGUNTA POR MLC. PROHIBIDO darle ninguna cifra, tasa o equivalencia de MLC, y PROHIBIDO tratarlo como si fuera dolar: esa tasa cambia a diario y NO la tienes. NO llames a ninguna herramienta de calculo para esto. Di UNA sola linea natural: que para el MLC le atiende enseguida un companero, porque esa tasa se confirma en el momento. Si en el mismo mensaje pide ademas algo que SI sabes hacer (remesa en CUP, recarga, Zelle), esa parte la atiendes con normalidad.');
}
// REFERENCIA IMPOSIBLE: NO SE CONFIRMA NADA (087).
// El 13-ago sanzjuanpastor mando una CAPTURA de otro chat que dentro tenia la
// FOTO de un comprobante. La vision se invento las dos cifras: 5.000 GYD con
// ref 10319372234891, cuando el comprobante decia 26.000 y 10395727229361.
// El SQL ya manda ese deal a Incidencia (cerebro_registrar_deposito), pero eso
// el cliente no lo ve: sin esta nota el modelo le seguia diciendo "recibimos su
// deposito de 5,000 GYD", que era falso.
// La regla es la misma de `cerebro_transid_plausible`: el contador de MMG solo
// crece, asi que por debajo del suelo historico no puede existir. El suelo lo
// sirve `Contexto conversacion` desde cerebro_config.
// Va la ULTIMA para ganar cualquier colision con las notas de confirmacion.
try {
  const piso = Number(ctx.transid_minimo || 0);
  const refs = (s.comprobantes || []).map(c => String(c?.referencia || '').replace(/[^0-9]/g, ''))
                 .filter(x => x.length > 0);
  const imposible = piso > 0 && refs.length > 0 && refs.some(x => Number(x) < piso);
  if (imposible) {
    notas.push('LA REFERENCIA DEL COMPROBANTE ES IMPOSIBLE: ese numero no puede ser un TransID de MMG, casi seguro se leyo mal de una CAPTURA de pantalla o de una foto de otra pantalla. PROHIBIDO decir que se recibio el deposito, PROHIBIDO repetir el importe y PROHIBIDO dar ninguna cifra de este comprobante. Di en UNA linea que la imagen no se ve con claridad y pidele que mande el comprobante ORIGINAL de MMG, no una captura de otro chat. Ya esta avisado el equipo.');
  }
} catch (e) {}
let mensaje = texto || '(el cliente envio solo imagenes, sin texto)';
if (notas.length) { mensaje += '\n\n[CONTEXTO DEL SISTEMA - el cliente NO ve esto]\n- ' + notas.join('\n- ');
}
// ---------------------------------------------------------------------------
// PLAN SEMANTICO (fase 4C). ADITIVO: no cambia ni una decision del Decisor.
// El texto de `mensaje` sale exactamente igual que en BLUE; esto es una lectura
// en forma de datos de lo que el Decisor YA decidio, para que el renderer pueda
// comprobar cifras y repeticiones sin leer prosa. Si algo falla aqui, `plan`
// vale null y el renderer se aparta.
// ---------------------------------------------------------------------------
let plan = null;
try {
  let cruceP = null;
  try { cruceP = $('Cruzar deposito con MMG').first().json ?? null; } catch (e) {}
  const veredicto = String(cruceP?.resultado ?? '');
  const comp = s.comprobante || null;

  const hechos = {};
  if (cruceP && cruceP.depositado !== null && cruceP.depositado !== undefined) {
    hechos.deposito = { valor: Number(cruceP.depositado), moneda: 'GYD', fuente: 'libro' };
  } else if (comp && Number(comp.monto) > 0) {
    hechos.deposito = { valor: Number(comp.monto), moneda: String(comp.moneda || 'GYD'), fuente: 'vision' };
  }
  if (tarjetaCtx) { hechos.beneficiario_tarjeta = { termina_en: String(tarjetaCtx).slice(-4), fuente: 'registrado' }; }
  if (celularCtx) { hechos.beneficiario_celular = { fuente: 'registrado' }; }
  if (zelleCompleto) { hechos.zelle = { titular: !!zelleNomCtx, cuenta: !!zelleCtaCtx, fuente: 'registrado' }; }
  hechos.horario = abierto ? (ctx.por_cerrar ? 'proximo_a_cerrar' : 'abierto') : 'cerrado';
  hechos.presentacion = h.primer_del_dia ? 'primer_contacto_del_dia' : 'ya_presentado';
  hechos.deposito_estado = veredicto.startsWith('verificado') ? 'verificado'
                          : (comp ? 'registrado' : (ctx.via_deposito_ya_usada ? 'hecho' : null));

  const intents = [];
  if (h.primer_del_dia) { intents.push('greet'); }
  if (comp && !s.comprobante_duplicado) { intents.push('confirm_deposit'); }
  if (sabeDestino && (tarjetaCtx || zelleCompleto)) { intents.push('confirm_beneficiary'); }
  if (!sabeDestino) { intents.push('request_beneficiary'); }
  else if (!comp && !ctx.via_deposito_ya_usada) { intents.push('request_receipt'); }
  if (esperaTercero) { intents.push('acknowledge_waiting'); }
  if (ctx.pide_mlc) { intents.push('handoff'); }

  const estado = ctx.pide_mlc ? 'handoff'
               : (!sabeDestino ? 'collection'
               : (comp ? 'instruction' : 'collection'));

  const siguiente = !sabeDestino ? 'dar_beneficiario'
                  : (!comp && !ctx.via_deposito_ya_usada ? 'mandar_comprobante'
                  : (esperaTercero ? 'esperar' : 'ninguna'));

  const riesgo = (!sabeDestino && comp) ? 'confirmar_beneficiario'
               : (comp && !veredicto.startsWith('verificado') ? 'confirmar_importe'
               : (ctx.pide_mlc ? 'persona_pendiente' : 'ninguno'));

  const prohibido = [];
  if (!sabeDestino) { prohibido.push('prometer_transferencia'); }
  if (ctx.pide_mlc) { prohibido.push('dar_cifras_de_mlc'); }
  prohibido.push('explicar_formatos', 'narrar_sistemas_internos', 'tutear');

  plan = {
    version: 1,
    estado,
    idioma: (String(ctx.muestra_idioma || '').length && avisoIdioma) ? 'en' : 'es',
    trato: 'usted',
    intents,
    hechos,
    siguiente_accion: siguiente,
    riesgo,
    paquetes_atomicos: [['deposito.valor', 'deposito.moneda'],
                        ['beneficiario_tarjeta.termina_en', 'beneficiario_celular']],
    prohibido,
    verbosidad: estado === 'instruction' ? 'estructurada' : 'concreta',
    contexto_chars: notas.length ? mensaje.length - texto.length : 0,
  };
} catch (e) { plan = null; }

return [{ json: { ruta: 'agente', mensaje, telefono_e164: tel,
                  conversation_id: s.conversation_id, plan } }];
