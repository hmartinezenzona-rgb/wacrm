  else if (et === 'Por verificar') { est = 'ESTADO REAL DEL ENVIO EN CURSO' + monto + ': el deposito YA LLEGO y esta EN VERIFICACION. Si el cliente pregunta como va lo suyo, dile que una persona lo revisa y le confirma por aqui.'; }
  else if (et === 'Lista para transferir') { est = 'ESTADO REAL DEL ENVIO EN CURSO' + monto + ': el deposito YA FUE VERIFICADO y la transferencia esta por hacerse. Si el cliente pregunta como va lo suyo, dile que ya quedo verificado y que el equipo esta procesando la transferencia y le avisamos por aqui cuando este hecha. SIGUE sin poder confirmar que ya se envio: eso lo confirma el operador.'; }
  else if (et === 'Incidencia') { est = 'ESTADO REAL DEL ENVIO EN CURSO' + monto + ': hay una INCIDENCIA y un operador la esta revisando. Si el cliente pregunta como va lo suyo, dile con calma que una persona lo revisa y le confirma por aqui. NO inventes el motivo ni prometas tiempos.'; }
