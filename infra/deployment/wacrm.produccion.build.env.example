# Configuracion de compilacion para PRODUCCION del CRM.
#
#   cp wacrm.produccion.build.env.example wacrm.produccion.build.env
#   WACRM_BUILD_ENV=infra/deployment/wacrm.produccion.build.env \
#       ./infra/deployment/build-wacrm.sh
#
# Fichero APARTE del de staging, y no un `sed` sobre aquel. Las NEXT_PUBLIC_*
# se INCRUSTAN en el bundle: el artifact de staging y el de produccion no son
# el mismo binario con distinta configuracion, son dos cosas distintas. Y uno
# puesto en el sitio del otro no falla — arranca, sirve y responde 200 contra
# la base equivocada.
#
# El despliegue comprueba las dos ultimas lineas contra el manifiesto.

NEXT_PUBLIC_SUPABASE_URL=https://hqztotshnlzaiziwjyzh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<la anon de PRODUCCION>
NEXT_PUBLIC_SITE_URL=https://wacrm.onlinefreedom.site

WACRM_ENVIRONMENT=production
