// Debounce adaptativo: decide si el lote pendiente parece un paquete a medias.
// Solo extiende UNA vez por ejecucion ($runIndex > 0 = ya extendimos y nada nuevo llego).
const evs = $input.all().map(i => i.json);
let incompleto = false;
if ($runIndex === 0 && evs.length) {
  const textos = evs.filter(e => e.tipo === 'text' && (e.contenido ?? '').toString().trim());
  const ultimo = textos.length ? textos[textos.length - 1].contenido.toString().trim() : '';
  // 1) El ultimo texto anuncia que viene mas (o termina en dos puntos)
  const anuncio = /((son (a )?est[oa]s|estas son|estos son|ahora (te|le) (paso|mando|envio|env\u00edo)|(te|le) (paso|mando) (los datos|la tarjeta|el numero|el n\u00famero|el celular)|aqu[i\u00ed] (te |le )?van|ah[i\u00ed] (te |le )?van)|:)\s*$/i.test(ultimo);
  // 2) Datos del beneficiario a medias: tarjeta sin celular, o celular sin tarjeta
  const todo = evs.filter(e => e.tipo === 'text').map(e => (e.contenido ?? '').toString()).join('\n');
  const norm = todo.replace(/(?<=\d)[ \t\-_.\u00A0\u202F]+(?=\d)/g, '');
  const runs = norm.match(/\d+/g) || [];
  let hayTarjeta = false, hayCelular = false;
  for (const r of runs) {
    if (r.length === 16) hayTarjeta = true;
    else if (r.length === 8 && /^(5|63)/.test(r)) hayCelular = true; // 5xxxxxxx o 63xxxxxx (ETECSA, dic-2023)
    // El run de 24 digitos ya NO se parte (fase 1B): un numero pegado a otro no
    // es "tarjeta y celular", es un numero que hay que volver a pedir.
  }
  const datosAMedias = hayTarjeta !== hayCelular;
  // 3) The last text names a destination still to come ("a la cuenta", "al zelle", "a este numero") (2026-11-12, case
  //    1727ef31: the account arrived 9 s after the batch was answered). "a la misma cuenta" is a complete answer.
  const destinoAnunciado = /(?:^|\s)(?:a|al|en)\s+(?:(?:la|el|esta|este|esa|ese)\s+)?(?:cuenta|tarjeta|zelle|n[uú]mero|celular)\s*[.!]*$/i.test(ultimo);
  // 4) A Zelle is asked for and the batch carries no account yet (no e-mail, no US phone, no "same account" request).
  const tieneCorreo = /\S+@\S+\.\S+/.test(todo);
  const tieneUs = /(?:\+?1[\s.\-]*)?\(?\d{3}\)?[\s.\-]*\d{3}[\s.\-]*\d{4}\b/.test(todo);
  const pideMisma = /\bmism[oa]\s+(cuenta|zelle|correo|n[uú]mero|persona)|\bla de siempre\b|\b(la|cuenta) anterior\b/i.test(todo);
  const zelleSinCuenta = /\bzelle\b/i.test(todo) && !/\?/.test(todo) && !tieneCorreo && !tieneUs && !pideMisma;
  incompleto = anuncio || datosAMedias || destinoAnunciado || zelleSinCuenta;
}
const maxId = evs.length ? Math.max(...evs.map(e => Number(e.id))) : 0;
return [{ json: { id: maxId, incompleto } }];