  if (tarjetaCtx || celularCtx) {
    notas.push('MEZCLA DE VIAS EN EL MISMO ENVIO: llegaron datos de Zelle (' + cuenta + ') y TAMBIEN datos cubanos (tarjeta o celular). Eso lo atiende una persona: llama derivar_humano y no intentes resolverlo tu.');
  } else {
