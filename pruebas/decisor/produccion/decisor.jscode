// El destino de una recarga es UN NUMERO de telefono, no una tarjeta.
// (gate 78, 2026-10-01) "YA ESTA REGISTRADO" only for the datum detected in this turn.
// `Contexto conversacion` lists the vigente beneficiaries of the open operations; the old flag
// (tiene_beneficiario: ANY complete beneficiary) told the model a new Zelle was registered when
// another one was, and the model obeyed and wrote nothing (gate 77: 0/30 -> 25/30 once the
// sentence is true). Without the list (an older Contexto) the Cuban branch keeps its old
// behaviour (the old flag) in both branches.
const regBenDisponible = Array.isArray(ctx.beneficiarios_registrados);
const regBen = regBenDisponible ? ctx.beneficiarios_registrados : [];
const normCta = (x) => { const t = String(x ?? '').trim().toLowerCase(); if (t.includes('@')) return t;
  const d = t.replace(/\D/g, ''); return (d.length === 11 && d[0] === '1') ? d.slice(1) : d; };
const normNom = (x) => String(x ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
const soloDig = (x) => String(x ?? '').replace(/\D/g, '');
const zelleRegistrado = regBenDisponible
  ? (!!zelleCtaCtx && regBen.some((b) => b.t === 'zelle'
      && normCta(b.cuenta) === normCta(zelleCtaCtx) && (!zelleNomCtx || normNom(b.nombre) === normNom(zelleNomCtx))))
  : !!ctx.tiene_beneficiario;
const cubanoRegistrado = !!(tarjetaCtx && celularCtx) && regBen.some((b) => b.t !== 'zelle'
  && soloDig(b.tarjeta) === soloDig(tarjetaCtx) && soloDig(b.celular).slice(-8) === soloDig(celularCtx).slice(-8));
// (gate 82, 2026-10-02) REPARTO EN CURSO, MONTO EN GYD DE UN REPARTO Y MINIMOS DE DEPOSITO.
