// Migration 184 refuses that in the DB; this note keeps the model on registrar_reparto_multiple.
// The amount "5 mil a cada una" was ignored: the deposit minimums were not in the context, so the
// model could not tell that 5,000 GYD per card only fits a CUP remesa (Clasica/Tropical start at
// 13,000). The minimums come from cerebro_config through `Contexto conversacion` (ctx.minimos).
const g82TiposReparto = ['multiple_distribution', 'clasica', 'tropical'];
const g82Slots = regBen.filter((b) => g82TiposReparto.includes(b.t) && Number(b.posicion) >= 1 && Number(b.posicion) <= 3)
  .sort((a, b) => Number(a.posicion) - Number(b.posicion));
const g82RepartoVigente = g82Slots.length >= 2;
const g82N = (x) => Number(x).toLocaleString('en-US');
const g82Recibe = (b) => (b.monto == null ? null
  : (b.t === 'multiple_distribution' ? g82N(b.monto) + ' CUP' : g82N(b.monto) + ' USD ' + (b.t === 'clasica' ? 'Clasica' : 'Tropical')));
const g82NotaReparto = () => {
  const faltas = [];
  const lineas = g82Slots.map((b) => {
    const k = b.posicion;
    if (!b.tarjeta) faltas.push('la tarjeta ' + k);
    if (!b.celular) faltas.push('el celular de la tarjeta ' + k);
    if (b.monto == null) faltas.push('cuanto recibe la tarjeta ' + k);
    return k + ') tarjeta ' + (b.tarjeta || '(falta)') + ', celular ' + (b.celular || '(falta)') + ', recibe ' + (g82Recibe(b) || '(falta)');
  });
  return 'REPARTO EN CURSO entre ' + g82Slots.length + ' tarjetas. Guardado ahora: ' + lineas.join('; ') + '. '
    + (faltas.length ? 'FALTA: ' + faltas.join(', ') + '. Pidelo con naturalidad, UNA pregunta por mensaje. '
