    + ' con cadena vacia en lo que no cambia. PROHIBIDO llamar gestionar_beneficiario mientras haya un reparto: no'
    + ' completa el reparto. Si el cliente dice que un dato vale para todas ("el celular es el mismo para las dos"),'
    + ' ponlo en TODAS las posiciones. Si da una tarjeta que no esta en el reparto o parece cambiar de idea, PREGUNTALE'
    + ' antes de guardar nada.';
};
const g82Min = (() => {
  const m = ctx.minimos || {};
  const n = (k) => { const v = Number(m[k]); return Number.isFinite(v) && v > 0 ? v : null; };
  // (307) Los servicios en USD llevan su minimo en USD; el monto en GYD lo da la tasa del dia.
  return { cup: n('minimo_gyd_cup'), usd: n('minimo_gyd_usd'),
           usdClasica: n('minimo_usd_clasica') || 20,
           usdTropical: n('minimo_usd_tropical') || 20,
           usdZelle: n('minimo_usd_zelle') || 50,
           usdEfectivo: n('minimo_usd_efectivo') || 100,
           recarga: n('minimo_gyd_recarga'), recargaHasta: n('minimo_gyd_recarga_hasta'), tramite: n('minimo_gyd_tramite') };
})();
const g82MinimosTxt = g82Min.cup
  ? ('MINIMOS DE DEPOSITO (salen de la base): remesa en CUP ' + g82N(g82Min.cup) + ' GYD'
     + '; tarjeta Clasica ' + g82N(g82Min.usdClasica) + ' USD'
     + '; tarjeta Tropical ' + g82N(g82Min.usdTropical) + ' USD'
