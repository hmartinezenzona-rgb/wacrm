  if (h.primer_del_dia) { intents.push('greet'); }
  if (comp && !s.comprobante_duplicado) { intents.push('confirm_deposit'); }
  if (sabeDestino && (tarjetaCtx || zelleCompleto)) { intents.push('confirm_beneficiary'); }
  if (!sabeDestino) { intents.push('request_beneficiary'); }
  else if (!comp && !ctx.via_deposito_ya_usada) { intents.push('request_receipt'); }
